{
  "description": "p4-phi's hooks. run-hook.sh runs scripts/phi.py at SessionStart, UserPromptSubmit, Stop, StopFailure and SessionEnd, whose hooks share 1.5 seconds that a plugin's timeout does not raise. recall-hook.sh runs scripts/hook.py at every event here, ConfigChange among them, and hook.py hands phi.py its checks around a tool call and at a subagent's start and stop. Every entry on which onFailure acts sets it to continue, so a runner that cannot start, as on Windows without Git Bash, blocks no call, prompt or change; Stop, SubagentStop and the async entries set none, since onFailure does nothing there. register.ts is the hooks module, whose functions run inside Claude Code: it finds the python the runners proved, and it is an orchestrator's watcher, which runs `phi.py look` at a turn's end, at a message's arrival and on its timer, it keeps the session's context fill and plan limits in usage.json in the session's folder, it wakes an idle session: it sends the report of a worker's turn to the session that started it, and it starts a turn for the work a turn's wait left unmoved, and it sets the rules built into p4-phi as a section of the system prompt, so no SessionStart entry hands them, and it binds each subagent to the Agent call that launched it, which the subagent-start handler reads, and it keeps the origin Claude Code stamps on each prompt in origin.json, where the UserPromptSubmit hooks read whose message the prompt is.",
  "modules": ["./register.ts"],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.sh\" session-start",
            "timeout": 20,
            "onFailure": "continue"
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/recall-hook.sh\" layout",
            "timeout": 15,
            "onFailure": "continue"
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/recall-hook.sh\" catch-up",
            "timeout": 20,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.sh\" user-prompt-submit",
            "timeout": 20,
            "onFailure": "continue"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/recall-hook.sh\" recall",
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.sh\" stop",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/recall-hook.sh\" close",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/recall-hook.sh\" train",
            "async": true
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.sh\" stop-failure",
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.sh\" session-end",
            "onFailure": "continue"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/recall-hook.sh\" agent",
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/recall-hook.sh\" lookup-check",
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/recall-hook.sh\" lookup-record",
            "timeout": 10,
            "onFailure": "continue"
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/recall-hook.sh\" lookup-record-async",
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/recall-hook.sh\" lookup-record",
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": ".+",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/recall-hook.sh\" subagent-stop",
            "timeout": 30
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "matcher": "local_settings|project_settings|user_settings",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/recall-hook.sh\" settings",
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/recall-hook.sh\" subagent-start",
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ]
  }
}
