# a virtual environment at the root, where lbiza/scripts/make_venv.py built one before the store held it in .claude/p4/.venv
.venv/

# what Claude Code and the plugins write for a session started in this checkout: its settings and its store
.claude/

# compiled Python files, and what pytest keeps between runs
__pycache__/
*.py[cod]
.pytest_cache/

# the interpreter each plugin's hook runner proved once, written by hooks/run-hook.sh and hooks/recall-hook.sh
lbiza/plugins/*/.python

# what `claude plugin eval` writes for each run of a plugin's evals suite: its report and its result document
lbiza/plugins/*/evals/results/
