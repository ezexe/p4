# a virtual environment at the root, which the store holds in .claude/p4/.venv
.venv/

# what Claude Code and the plugins write for a session started in this checkout: its settings and its store, less
# the project's own skills, which are committed. A file cannot be re-included under an excluded folder, so the
# folder's contents are excluded and not the folder.
.claude/*
!.claude/skills/

# compiled Python files, and what pytest keeps between runs
__pycache__/
*.py[cod]
.pytest_cache/

# the interpreter each plugin's hook runner proved once, written by hooks/run-hook.sh and hooks/recall-hook.sh
lbiza/plugins/*/.python

# what `claude plugin eval` writes for each run of a plugin's evals suite: its report and its result document
lbiza/plugins/*/evals/results/
